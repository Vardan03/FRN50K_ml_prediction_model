CREATE VIEW hourly_business_summary AS
SELECT
    sd.city_id,
    sd.store_id,
    sd.product_id,
    sd.first_category_id,
    sd.second_category_id,
    sd.third_category_id,

    sd.dt::date AS sale_date,
    h.hour_of_day,

    (string_to_array(
        trim(
            regexp_replace(
                replace(replace(sd.hours_sale, '[',''),']',''),
                '\s+',
                ' ',
                'g'
           	 )
        	),
        	' '
	    )::numeric[]
	)[h.hour_of_day + 1] AS hourly_sales,

    EXTRACT(DOW FROM sd.dt::date) AS day_of_week,

    CASE 
        WHEN EXTRACT(DOW FROM sd.dt::date) IN (0,6) THEN 1
        ELSE 0
    END AS is_weekend,

    CASE
        WHEN h.hour_of_day BETWEEN 6 AND 11 THEN 'morning'
        WHEN h.hour_of_day BETWEEN 12 AND 17 THEN 'afternoon'
        WHEN h.hour_of_day BETWEEN 18 AND 22 THEN 'evening'
        ELSE 'night'
    END AS time_of_day,

    CASE WHEN sd.discount > 0 THEN 1 ELSE 0 END AS is_promo,
    sd.holiday_flag,
    sd.activity_flag,

    CASE 
        WHEN sd.stock_hour6_22_cnt = 0 THEN 1
        ELSE 0
    END AS is_stockout,

    CASE
        WHEN sd.precpt > 0 THEN 'bad_weather'
        ELSE 'good_weather'
    END AS weather_category,

    sd.avg_temperature,
    sd.avg_humidity,
    sd.avg_wind_level

FROM sales_data sd
CROSS JOIN generate_series(0,23) AS h(hour_of_day);
