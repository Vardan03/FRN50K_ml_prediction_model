-- Performance comparison: Promo vs Regular
SELECT 
    CASE 
        WHEN is_promo = 1 THEN 'PROMO HOURS (with discount)'
        ELSE 'REGULAR HOURS (no discount)'
    END AS price_status,
    
    COUNT(*) AS total_hours,
    ROUND(AVG(hourly_sales)::numeric, 2) AS avg_sales,
    ROUND(PERCENTILE_CONT(0.5) WITHIN GROUP (ORDER BY hourly_sales)::numeric, 2) AS median_sales,
    ROUND(SUM(hourly_sales)::numeric, 2) AS total_sales,
    ROUND((100.0 * SUM(CASE WHEN hourly_sales > 0 THEN 1 ELSE 0 END) / COUNT(*))::numeric, 1) AS activity_rate_pct,
    
    ROUND(MAX(hourly_sales)::numeric, 2) AS peak_sales,
    ROUND(PERCENTILE_CONT(0.9) WITHIN GROUP (ORDER BY hourly_sales)::numeric, 2) AS p90_sales,
    
    ROUND((100.0 * SUM(CASE WHEN is_stockout = 1 THEN 1 ELSE 0 END) / COUNT(*))::numeric, 2) AS stockout_rate_pct

FROM hourly_business_summary
GROUP BY is_promo
ORDER BY is_promo DESC;