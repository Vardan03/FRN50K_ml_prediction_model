-- Top 10 products with highest stockout rates
SELECT 
    product_id,
    first_category_id,
    second_category_id,
    third_category_id,
    COUNT(*) AS total_hours,
    SUM(CASE WHEN is_stockout = 1 THEN 1 ELSE 0 END) AS stockout_hours,
    ROUND(100.0 * SUM(CASE WHEN is_stockout = 1 THEN 1 ELSE 0 END) / COUNT(*), 2) AS stockout_rate_pct,
    
    ROUND(SUM(hourly_sales), 2) AS total_sales,
    ROUND(AVG(CASE WHEN is_stockout = 0 THEN hourly_sales END), 2) AS avg_sales_in_stock,
    ROUND(SUM(CASE WHEN is_stockout = 1 THEN hourly_sales ELSE 0 END), 2) AS sales_during_stockout,
    
    ROUND(
        (AVG(CASE WHEN is_stockout = 0 THEN hourly_sales END) * SUM(CASE WHEN is_stockout = 1 THEN 1 ELSE 0 END)) -
        SUM(CASE WHEN is_stockout = 1 THEN hourly_sales ELSE 0 END),
        2
    ) AS estimated_sales_loss

FROM hourly_business_summary
GROUP BY product_id, first_category_id, second_category_id, third_category_id
HAVING COUNT(*) >= 24 
ORDER BY stockout_rate_pct DESC
LIMIT 10;