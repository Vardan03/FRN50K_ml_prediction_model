-- Products ranked by average hourly sales
SELECT 
    product_id,
    first_category_id,
    second_category_id,
    third_category_id,
    COUNT(*) AS total_hours_analyzed,
    ROUND(AVG(hourly_sales), 2) AS avg_hourly_sales,
    ROUND(SUM(hourly_sales), 2) AS total_sales,
    
    SUM(CASE WHEN hourly_sales > 0 THEN 1 ELSE 0 END) AS active_hours,
    ROUND(100.0 * SUM(CASE WHEN hourly_sales > 0 THEN 1 ELSE 0 END) / COUNT(*), 1) AS activity_rate_pct,
    
    ROUND(MAX(hourly_sales), 2) AS peak_hourly_sales,
    PERCENTILE_CONT(0.9) WITHIN GROUP (ORDER BY hourly_sales) AS p90_sales,
    ROUND(STDDEV(hourly_sales), 2) AS sales_volatility,
    
    SUM(CASE WHEN is_stockout = 1 THEN 1 ELSE 0 END) AS stockout_hours,
    ROUND(100.0 * SUM(CASE WHEN is_stockout = 1 THEN 1 ELSE 0 END) / COUNT(*), 2) AS stockout_rate_pct,
    
    COUNT(DISTINCT store_id) AS stores_selling

FROM hourly_business_summary
GROUP BY product_id, first_category_id, second_category_id, third_category_id
HAVING COUNT(*) >= 24
ORDER BY avg_hourly_sales DESC
LIMIT 20;